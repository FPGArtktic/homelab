# User unit (no root): publishes <name>.local -> server LAN IP via avahi.
# Installed to ~/.config/systemd/user/ by scripts/install.sh.
[Unit]
Description=Homelab mDNS .local A-record aliases
After=network-online.target
Wants=network-online.target

[Service]
# avahi-publish is unpacked from the avahi-utils .deb by scripts/install.sh (no root).
Environment=PATH=%h/.local/avahi-utils/usr/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/homelab/mdns-aliases.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
